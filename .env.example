# Firebase configuration (optional).
#
# Without these values the app works fully on localStorage (per-browser only).
# Fill them in to enable Google sign-in + cross-device sync via Firestore:
# copy this file to ".env.local" and paste the values from your Firebase
# project (Project settings → General → "Your apps" → SDK setup & config).
#
# These are web client keys and are safe to ship in a browser build; access is
# secured by Firebase Auth + Firestore rules (see README).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
